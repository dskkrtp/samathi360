---
// ตัวแปรสำหรับโลโก้ หรือนำเข้าจาก props/import
const logoSrc = "/360logo.jpg"; // อย่าลืมเปลี่ยน path เป็นที่อยู่รูปจริงนะครับ
---

<header class="sticky top-0 z-50 w-full bg-white/90 backdrop-blur-md border-b border-gray-100 shadow-sm transition-all">
  <div class="max-w-5xl mx-auto px-6 sm:px-8">
    <div class="flex items-center justify-between h-20">
      
      {/* ฝั่งซ้าย: โลโก้ */}
      <a href="/" class="flex-shrink-0 cursor-pointer hover:opacity-80 transition-opacity duration-300">
        <img 
          src={logoSrc} 
          alt="Logo" 
          class="h-12 w-12 rounded-full shadow-sm"
        />
      </a>

      {/* ฝั่งขวา: เมนู Navigation */}
      <nav class="flex space-x-8">
        <a 
          href="/about" 
          class="text-gray-600 hover:text-[#1b365d] font-medium text-base transition-colors duration-300 relative group py-2"
        >
          เกี่ยวกับเรา
          
          {/* เอฟเฟกต์เส้นใต้เวลา Hover */}
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#1b365d] transition-all duration-300 group-hover:w-full"></span>
        </a>
      </nav>

    </div>
  </div>
</header>