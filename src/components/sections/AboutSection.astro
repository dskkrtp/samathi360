---
import SectionTitle from "../ui/SectionTitle.astro";

interface Props {
  image: string;
  imageAlt: string;
  title: string;
  description: string;
  imagePosition?: "left" | "right"; // กำหนดให้เลือกได้แค่ซ้ายหรือขวา
}

const { 
  image, 
  imageAlt, 
  title, 
  description, 
  imagePosition = "left" // ค่าเริ่มต้นคือรูปอยู่ซ้าย
} = Astro.props;
---

<section class="py-20">
  <div class="max-w-6xl mx-auto px-6">
    <div class={`grid md:grid-cols-2 gap-12 items-center ${imagePosition === "right" ? "md:flex-row-reverse" : ""}`}>
      
      {/* รูปภาพ */}
      <div class={`rounded-3xl bg-gray-100 aspect-square overflow-hidden ${imagePosition === "right" ? "md:order-2" : "md:order-1"}`}>
        <img src={image} alt={imageAlt} class="w-full h-full object-cover" />
      </div>

      {/* ข้อความ (เรียกใช้ SectionTitle) */}
      <div class={imagePosition === "right" ? "md:order-1" : "md:order-2"}>
        <SectionTitle 
          align="left" 
          title={title} 
          description={description} 
        />
      </div>

    </div>
  </div>
</section>