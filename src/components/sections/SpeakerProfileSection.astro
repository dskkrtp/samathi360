---
import { Icon } from 'astro-icon/components';

interface FeatureItem {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  image: string;
  imageAlt: string;
  imagePosition?: "left" | "right";
  
  tagline?: string;
  title1: string;
  description1: string;
  subDescription?: string[];

  buttonText?: string;
  buttonHref?: string;

  title2?: string;
  features?: FeatureItem[];
}

const { 
  image, 
  imageAlt, 
  imagePosition = "left",
  tagline,
  title1,
  description1,
  subDescription = [],
  buttonText,
  buttonHref,
  title2,
  features = []
} = Astro.props;
---

<section class="py-20">
  <div class="max-w-6xl mx-auto px-6">
    
    <div class="bg-white rounded-3xl p-8 md:p-12 shadow-sm border border-gray-100 overflow-hidden">
      
      {/* ส่วนบน */}
      <div class="grid md:grid-cols-12 gap-8 items-center mb-12 md:mb-0">
        
        {/* รูปภาพทางซ้าย */}
        <div class={`flex justify-center md:justify-start ${imagePosition === "right" ? "md:order-2 md:col-start-8" : "md:order-1 md:col-span-5"}`}>
          <div class="bg-gray-50 w-72 h-96 md:w-96 md:h-[450px] rounded-3xl overflow-hidden shrink-0 shadow-sm">
            <img src={image} alt={imageAlt} class="w-full h-full object-cover" />
          </div>
        </div>

        {/* ส่วนข้อความทางขวา */}
        <div class={`flex flex-col justify-between h-full text-center md:text-left md:pl-4 ${imagePosition === "right" ? "md:order-1 md:col-span-7" : "md:order-2 md:col-span-7"}`}>
          <div>
            {tagline && (
              <div class="flex items-center justify-center md:justify-start gap-3 text-xs md:text-sm font-bold tracking-widest text-primary uppercase mb-3">
                <span class="w-8 h-[2px] bg-primary"></span>
                {tagline}
              </div>
            )}
            
            <h2 class="text-4xl md:text-5xl font-extrabold whitespace-pre-line text-gray-900 leading-tight tracking-wide">
              {title1}
            </h2>
            
            {/* subDescription แบบ Dot (ปรับให้ชิดซ้ายตลอดทั้งมือถือและ Desktop) */}
            {subDescription.length > 0 && (
              <ul class="mt-4 space-y-2 text-gray-600 text-base md:text-lg">
                {subDescription.map((item) => (
                  <li class="flex items-start justify-start gap-3">
                    <span class="inline-block w-2 h-2 mt-2.5 rounded-full bg-gray-400 shrink-0"></span>
                    <span class="text-left">{item}</span>
                  </li>
                ))}
              </ul>
            )}

            {description1 && (
              <div class="flex items-center justify-center md:justify-start gap-3 mt-6 text-xs md:text-sm font-semibold tracking-widest text-gray-600 uppercase">
                {description1}
                <span class="w-12 h-[1px] bg-gray-400"></span>
              </div>
            )}
          </div>

          {/* ปุ่มบน Desktop */}
          {buttonText && buttonHref && (
            <div class="hidden md:block mt-12 mb-4">
              <a 
                href={buttonHref}
                class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-primary text-white font-semibold hover:bg-primary transition-all duration-300 shadow-md group"
              >
                {buttonText} 
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </a>
            </div>
          )}
        </div>

      </div>

      {/* ส่วนล่าง: เส้น Divider, title2 และ 4 ช่องฟีเจอร์ */}
      <div class="pt-8 border-t border-gray-200/60 mt-12">
        
        {title2 && (
          <div class="mb-6">
            <h3 class="text-xl md:text-2xl font-bold text-gray-900">
              {title2}
            </h3>
          </div>
        )}

        {/* 4 ช่องฟีเจอร์ */}
        {features.length > 0 && (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            {features.map((item) => (
              <div class="flex items-center p-2 rounded-2xl bg-blue-50 border border-gray-100 shadow-2xs">
                <div class="p-3 rounded-xl text-primary shrink-0">
                  <Icon name={item.icon} class="w-6 h-6" />
                </div>
                <div class="flex flex-col">
                  <h4 class="text-xs font-bold tracking-wider text-gray-900 uppercase">{item.title}</h4>
                  <p class="text-xs text-gray-500 mt-0.5">{item.description}</p>
                </div>
              </div>
            ))}
          </div>
        )}

        {/* ปุ่ม (โหมดมือถือ แสดงไว้ท้ายสุด) */}
        {buttonText && buttonHref && (
          <div class="flex justify-center md:hidden pt-4">
            <a 
              href={buttonHref}
              class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-primary text-white font-semibold hover:bg-primary transition-all duration-300 shadow-md group w-full justify-center"
            >
              {buttonText} 
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
          </div>
        )}

      </div>

    </div>

  </div>
</section>