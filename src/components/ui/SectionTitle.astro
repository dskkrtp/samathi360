---
interface Props {
  title: string;
  description?: string;
  align?: "left" | "center";
}

const {
  title,
  description,
  align = "center"
} = Astro.props;
---

<div class={align === "center" ? "text-center mb-12" : "mb-12"}>

    <h2 class="text-4xl font-bold whitespace-pre-line">
        {title}
    </h2>

    {
        description && (
            <p class="mt-4 text-gray-600 max-w-2xl mx-auto whitespace-pre-line">
                {description}
            </p>
        )
    }

</div>