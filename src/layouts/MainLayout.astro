---
import "../styles/global.css";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {
  title?: string;
}

const { title = "InfoWeb" } = Astro.props;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    
    {/* เติมโค้ดบรรทัดนี้ลงไปครับ (สมมติว่าใช้ไฟล์ชื่อ favicon.png) */}
    <link rel="icon" type="image/jpg" href="/360logo.jpg" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-white text-gray-800">
    <Navbar />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>